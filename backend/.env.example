PORT=5000
MONGODB_URI=mongodb://localhost:27017/intellora

# IMPORTANT: In production, generate 64-character hex keys using: openssl rand -hex 64
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Set to 'production' in live environment to enforce secure cookies and startup guards
NODE_ENV=development
